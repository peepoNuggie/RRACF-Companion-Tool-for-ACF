# Build output. Built with build.bat; released builds are attached to GitHub
# releases rather than committed, so the repo never carries a stale binary.
RRACF.exe
*.pdb

# NOTE: retoc and repak ARE tracked, in Resources/retoc and Resources/repak.
# They are unmodified upstream releases kept under their own LICENSE files so
# the repo builds into something runnable. Do not add a blanket *.exe rule -
# it would silently drop them.

# Created at runtime, beside the exe or under Resources/
Output/
rracf-settings.txt
rracf-camomap.txt

# Downloaded mods - other people's work, never ours to redistribute.
# Test mods belong in Downloads/ and mods being converted in Input/, but the
# rules below mean a mod dropped ANYWHERE in the repo still cannot be
# committed by accident. A folder name is not proof of its contents, so the
# mod file extensions are ignored outright - nothing tracked is one of them.
Downloads/
Input/
*.pak
*.ucas
*.utoc

# Nexus download folders: Name-<modid>-<ver>-<ver>-<timestamp>
*-[0-9]*-[0-9]*-[0-9]*-[0-9]*/

# Scratch folders
_*/

# Packaged release zips - attached to the GitHub release, not committed.
# Archives are also how mods arrive, so this covers both.
Release/
*.zip
*.7z
*.rar

# Working notes, including the Nexus page BBCode
Claude Note*.txt

# Nexus page artwork - kept locally, not tracked
Textures Pictures etc/

# User data - saved slot settings are the user's, not the project's
Resources/Saves/
*.rracf

# Editor and toolchain droppings
.vs/
.vscode/
bin/
obj/
*.suo
*.user

# Windows shell junk
Thumbs.db
desktop.ini
